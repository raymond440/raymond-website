---
import { CONTACT_EMAIL } from '../site';

interface Props {
  titel: string;
}
const { titel } = Astro.props;
const onderwerp = encodeURIComponent(`Over: ${titel}`);
---
<p class="reageer">
  Raakt dit je, of ben je het oneens? <a href={`mailto:${CONTACT_EMAIL}?subject=${onderwerp}`}>Schrijf terug</a>. Ik lees het zelf.
</p>
