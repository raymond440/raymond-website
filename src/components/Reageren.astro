---
import { CONTACT_EMAIL } from '../site';

interface Props {
  titel: string;
}
const { titel } = Astro.props;
const onderwerp = encodeURIComponent(`Over: ${titel}`);
---
<p class="reageren">
  Raakt dit je, of ben je het oneens? <a href={`mailto:${CONTACT_EMAIL}?subject=${onderwerp}`}>Mail me</a>. Ik antwoord zelf.
</p>
