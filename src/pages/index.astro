---
import Basis from '../layouts/Basis.astro';
import Inschrijven from '../components/Inschrijven.astro';
import Lijst from '../components/Lijst.astro';
import { artikelen } from '../site';

const recent = (await artikelen()).slice(0, 5);
---
<Basis>
  <h1>Ik ben Raymond.</h1>
  <p>Ik schrijf op wat ik zie en waar ik in geloof.</p>

  <Lijst items={recent} />

  <Inschrijven plek="home" />
</Basis>
