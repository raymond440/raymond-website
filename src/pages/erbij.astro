---
import '@fontsource/pinyon-script/400.css';
import Basis from '../layouts/Basis.astro';
import Kruimel from '../components/Kruimel.astro';
import Aanvraag from '../components/Aanvraag.astro';
import ErbijLogo from '../components/ErbijLogo.astro';
import Honingraat from '../components/Honingraat.astro';

// De brief van Melissa: de tekst komt van Raymond. Zolang die er niet is, blijft het briefje verborgen.
const brief: string[] | null = null;
const punten = [
  { kop: 'Honing is het middel.', tekst: 'Tastbaar en deelbaar. Je kunt het vasthouden en weggeven zonder iets uit te leggen.', draai: -5 },
  { kop: 'Kruisbestuiving is de beweging.', tekst: 'Iets kleins wat iemands dag omgooit. Een gebaar, niet af te dwingen.', draai: 4 },
  { kop: 'De bij is de verbinder.', tekst: 'Een bij kiest geen belangrijke bloem en kijkt niet wat het meeste oplevert. Hij vliegt gewoon.', draai: -3 },
  { kop: 'Onbevangenheid is de sleutel.', tekst: 'Anders is honing een product en kruisbestuiving harde marketing. Nu is het een uitnodiging.', draai: 6 },
];
---
<Basis titel="ERBIJ, honing om te delen" beschrijving="ERBIJ is 100% deelbare honing: je koopt twee potjes, één voor jezelf en één om weg te geven aan iemand die het volgens jou verdient." ogId="erbij">
  <main class="pagina samen erbij-pagina">
    <Kruimel items={[{ label: 'ERBIJ' }]} />
    <section class="erbij-held" aria-labelledby="erbij-kop">
      <Honingraat />
      <h1 id="erbij-kop" class="vh">ERBIJ</h1>
      <ErbijLogo class="erbij-logo" />
      <p class="erbij-tag">100% deelbare honing.</p>
    </section>

    <section class="keynote erbij-tekst">
      <p class="erbij-intro">Bijen maken graag honing. Maar weet je waar ze écht blij van worden? Kruisbestuiving. Daarvoor rollen ze elke ochtend met plezier uit hun zeshoekige bedje. Wij ook, trouwens. Voor kruisbestuiving tussen mensen dan.</p>
      <p>Daarom is ERBIJ deelbaar. Je koopt hem alleen per twee potjes: één voor jezelf, en één om weg te geven aan iemand die het volgens jou verdient. Zonder reden, zonder er iets voor terug te vragen. Zoals een vriendschapsketting van vroeger. Het ene hartje hield je zelf, het andere gaf je aan een ander. Op het ene potje staat ER, op het andere BIJ.</p>

      <h3>Hoe het in elkaar zit.</h3>
      <ol class="raten">
        {punten.map((p, n) => (
          <li>
            <span class="raat-nr" style={`--draai:${p.draai}deg`} aria-hidden="true">
              <svg viewBox="0 0 104 120" focusable="false"><path d="M52 6 L97 31 L96 88 L51 114 L7 89 L8 32 Z" fill="none" stroke="var(--honing)" stroke-width="5" stroke-linejoin="round" /></svg>
              <b>{n + 1}</b>
            </span>
            <div><strong>{p.kop}</strong><span>{p.tekst}</span></div>
          </li>
        ))}
      </ol>

      <h3>Uit Groningen.</h3>
      <p>Ik ben een geboren Drent en woon in Friesland, maar ik heb heel veel met Groningen. Ik ging er naar school en heb er twintig jaar gewoond. Dus moest de honing uit Groningen komen. Hij komt van een bijenboer daar, die me een uur lang vertelde over zijn bijen. Daarna besloten we gewoon samen te beginnen. Voor het eerst stond ik bij de kasten en zag ik waar honing echt vandaan komt.</p>

      <aside class="erbij-weetje"><p class="label">Op het etiket</p><p>Tenminste houdbaar tot: zie onderkant pot. Maar niet ondersteboven houden zonder deksel, want dan loopt de honing eruit. In principe blijft honing voor altijd goed. In een oude Egyptische tombe vonden ze honing van meer dan 3.000 jaar oud, nog perfect eetbaar. Ja, die bijen kennen hun vak.</p></aside>

      {brief && (
        <section class="brief" aria-labelledby="brief-kop">
          <header class="brief-hoofd">
            <ErbijLogo class="brief-logo" label="ERBIJ" />
            <p class="brief-adres" id="brief-kop">Bijenkast 31G11, Groningen</p>
          </header>
          <div class="brief-tekst">{brief.map((a) => <p>{a}</p>)}</div>
          <div class="brief-ondertekening">
            <span class="handtekening">Melissa Bijdehand</span>
            <svg class="bijenvlucht" viewBox="0 0 220 60" aria-hidden="true" focusable="false">
              <path d="M4 44 C 30 4, 50 58, 80 28 S 130 6, 150 30 S 190 40, 206 18" fill="none" stroke="var(--inkt)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="1 7" />
              <g transform="translate(206 18) rotate(-20)">
                <ellipse cx="0" cy="0" rx="6" ry="4" fill="var(--honing)" stroke="var(--inkt)" stroke-width="1.2" />
                <path d="M-2 -3 L-2 3 M1 -3.2 L1 3.2" stroke="var(--inkt)" stroke-width="1.2" />
                <ellipse cx="-1" cy="-6" rx="3.5" ry="2.4" fill="var(--creme)" stroke="var(--inkt)" stroke-width="0.9" transform="rotate(-25 -1 -6)" />
              </g>
            </svg>
          </div>
          <p class="brief-voet">Alles wat bestaat, is verbonden.</p>
          <p class="brief-noot">Melissa bestaat niet echt. Ze is de stem van ERBIJ.</p>
        </section>
      )}

      <h3>Waar het nu staat.</h3>
      <p>ERBIJ is nog een prototype. Aan het etiket, het potje en de verpakking werk ik nog. De eerste potjes staan bij mij thuis. Ik bouw het rustig op, en ik deel onderweg wat goed gaat en wat niet. Juist dat hoort erbij.</p>

      <Aanvraag
        soort="erbij"
        klas="bestel honing"
        kop="Wil je erbij horen?"
        intro="Voor nu neem ik bestellingen met de hand aan. Laat hieronder weten hoeveel sets je wilt en waar ze heen mogen. Je krijgt een Tikkie van me, en daarna komt de honing naar je toe."
        knop="Bestel ERBIJ"
        bevestiging="Dank je. Je bestelling is bij me aangekomen. Ik stuur je een Tikkie, en daarna komt de honing naar je toe."
        velden={[
          { naam: 'naam', label: 'Je naam', verplicht: true, autocomplete: 'name' },
          { naam: 'mail', label: 'E-mail', type: 'email', verplicht: true, autocomplete: 'email' },
          { naam: 'aantal', label: 'Aantal sets van twee potjes', type: 'select', opties: ['1', '2', '3', '4', '5', 'Meer, ik mail je'], verplicht: true },
          { naam: 'telefoon', label: 'Telefoon, voor het Tikkie', type: 'tel', autocomplete: 'tel' },
          { naam: 'adres', label: 'Straat en huisnummer', verplicht: true, breed: true, autocomplete: 'street-address' },
          { naam: 'postcode', label: 'Postcode', verplicht: true, autocomplete: 'postal-code' },
          { naam: 'plaats', label: 'Plaats', verplicht: true, autocomplete: 'address-level2' },
          { naam: 'bericht', label: 'Nog iets?', type: 'textarea', breed: true, placeholder: 'Een ander bezorgadres, of een vraag.' },
        ]}
      >
        <p slot="prijs" class="prijs">Twee potjes, € 29,95.</p>
        <p class="klein">250 gram pure honing uit Groningen per potje. Honing kan van nature kristalliseren. Geef geen honing aan kinderen onder één jaar.</p>
      </Aanvraag>

      <p class="erbij-slot">Alles wat bestaat, is verbonden.</p>

      <p class="naar-ode"><span class="label">Waar het vandaan komt</span><a href="/onbevangen/#het-cadeau-dat-we-geven-noemen">Waarom ik iets wil geven zonder er iets voor terug te vragen, staat in de ode aan onbevangenheid.</a></p>
    </section>
  </main>
</Basis>
