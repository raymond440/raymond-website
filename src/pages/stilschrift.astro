---
import Basis from '../layouts/Basis.astro';
import Kruimel from '../components/Kruimel.astro';
import { weken, adres, kortDatum } from '../lib/bouwlog';

const bouwlog = await weken();
const doeMee = 'https://stilschrift.nl/doe-mee/?utm_source=raymondklompsma.nl&utm_medium=referral&utm_campaign=dertig-bladzijden';
---
<Basis titel="Stilschrift, ruimte in je hoofd" beschrijving="Stilschrift laat je dertig ochtenden schrijven: tien minuten per dag, met de hand, gratis. Daarna, als je wilt, papier om in te schrijven. De winkel opent op dinsdag 5 januari 2027." ogId="stilschrift">
  <main class="pagina samen stilschrift-pagina">
    <Kruimel items={[{ label: 'Stilschrift' }]} />
    <section class="keynote">
      <div class="ss-kop">
        <img class="ss-kantlijn" src="/stilschrift-kantlijn.svg" alt="" width="72" height="560" />
        <div>
          <h1>Stilschrift</h1>
          <p class="ss-onder">Ruimte in je hoofd. Op papier.</p>
        </div>
      </div>

      <p class="ss-intro">Ik schrijf sinds 2018 bijna elke dag. Het brengt me veel. Wat ik opschrijf, hoef ik niet meer mee te slepen. En ik vind terug wat ik dacht, ook als ik het allang vergeten was. Dat gun ik anderen ook.</p>
      <p>Stilschrift is mijn manier om dat te delen. Het begint met dertig ochtenden schrijven.</p>

      <h3>Wat het is.</h3>
      <p>Dertig bladzijden. De ochtend na je aanmelding krijg je de eerste mail, en dat dertig dagen op rij. Elke keer één vraag of opdracht. Jij schrijft tien minuten met de hand. Op welk papier maakt niet uit. Het is gratis.</p>
      <p>Geen app, geen meldingen, geen streak die je kwijt kunt raken. Een pen, papier en tien minuten.</p>

      <h3>Daarna, als je wilt.</h3>
      <p>Na dertig dagen heb je dertig bladzijden. Wil je door, dan laat ik zien waar ik zelf in schrijf of zou willen schrijven. Een kleine winkel met papier om in te schrijven. Weinig, en elk met een reden.</p>
      <p>Meedoen is geen voorwaarde om iets te kopen, en kopen geen voorwaarde om mee te doen.</p>

      <h3 id="hoe-ik-het-bouw">Hoe ik het bouw.</h3>
      <p>Apps en AI onthouden steeds meer voor ons. Toch zet ik Stilschrift bijna helemaal met AI op: de site, de mails, de verzending, de advertenties. Dat klinkt tegenstrijdig. Voor mij is het dat niet. AI doet het werk dat ik niet hoef te onthouden, zodat er ruimte blijft voor wat ertoe doet. Dat doet een notitieboek ook. Ik deel onderweg wat goed gaat en wat niet.</p>
      {bouwlog.length > 0 && (
        <>
          <p>Elke vrijdag schrijf ik op hoe het gaat.</p>
          <ol class="bouwlog-lijst">
            {bouwlog.map((w) => (
              <li>
                <time datetime={w.data.date.toISOString().slice(0, 10)}>{kortDatum(w.data.date)}</time>
                <a href={adres(w)}>{w.data.title}</a>
              </li>
            ))}
          </ol>
        </>
      )}

      <h3>Waar het nu staat.</h3>
      <p>Dertig bladzijden is open. Meld je vandaag aan, dan krijg je morgenochtend om zeven uur dag 1. De winkel opent op dinsdag 5 januari 2027.</p>

      <p class="ss-knoprij"><a class="knop" href={doeMee}>Doe mee, het is gratis</a></p>

      <img class="ss-handtekening" src="/handtekening-raymond.png" alt="Raymond" width="800" height="273" />

      <p class="erbij-slot">Je hoofd is geen archief.</p>

      <p class="naar-ode"><span class="label">Waar het vandaan komt</span><a href="/onbevangen/#ramen-die-lucht-geven">Over het luikje in je hoofd schreef ik in de ode aan onbevangenheid.</a></p>
    </section>
  </main>
</Basis>
