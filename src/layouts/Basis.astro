---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { CONTACT_EMAIL } from '../site';

interface Props {
  titel?: string;
  beschrijving?: string;
}
const { titel, beschrijving = 'Raymond Klompsma. Wat ik zie en waar ik in geloof.' } = Astro.props;
const paginaTitel = titel ? `${titel} · Raymond Klompsma` : 'Raymond Klompsma';
const pad = Astro.url.pathname;
const canonical = new URL(pad, Astro.site);
const nav = [
  { href: '/artikelen/', label: 'Artikelen' },
  { href: '/over/', label: 'Over mij' },
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Raymond Klompsma" href="/rss.xml" />
    <Analytics />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="naam" href="/">Raymond Klompsma</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={pad.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site">Mail me. Ik antwoord zelf. <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></footer>
    </div>
  </body>
</html>
