{
  "name": "raymond-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // alleen /api/* gaat langs het Worker-script, de rest komt direct uit de statische bestanden
    "run_worker_first": ["/api/*"]
  },
  // Aanvragen via de formulieren op Samenwerken. Vereist Email Routing op raymondklompsma.nl en een
  // geverifieerd bestemmingsadres (zie AGENTS.md, sectie Aanvraagformulieren). Nog niet ingesteld in Cloudflare.
  "send_email": [{ "name": "MAIL", "destination_address": "hey-raymond@klompsma.nl" }]
}
