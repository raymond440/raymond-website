{
  "name": "raymond-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // alleen /api/* gaat langs het Worker-script, de rest komt direct uit de statische bestanden
    "run_worker_first": ["/api/*"]
  },
  // Aanvragen via de formulieren op Samenwerken. Email Routing staat aan op raymondklompsma.nl en
  // raymond@klompsma.nl is daar geverifieerd als bestemming.
  "send_email": [
    { "name": "MAIL", "destination_address": "raymond@klompsma.nl" },
    // Cloudflare Email Service (verzenden naar klanten); vereist Workers Paid en een geonboard verzenddomein
    { "name": "EMAIL", "remote": true }
  ]
}
